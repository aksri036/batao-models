{
  "name": "@batao/models",
  "version": "0.2.0",
  "description": "Shared data models for batao frontend, backend and admin",
  "private": true,
  "license": "UNLICENSED",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/*"
      ]
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "typescript": "5.7.2"
  }
}
